# Example for GKE credentials loaded by:
# gcloud container clusters get-credentials kuest-prod-autopilot --region us-central1 --project my-gcp-project
kube_context = "gke_my-gcp-project_us-central1_kuest-prod-autopilot"
app_image    = "ghcr.io/kuest/prediction-market:v1.0.0"
site_url     = "https://markets.example.com"

secret_env = {
  BETTER_AUTH_SECRET                  = "replace-me"
  CRON_SECRET                         = "replace-me"
  POSTGRES_URL                        = "replace-me"
  ADMIN_WALLETS                       = "replace-me"
  KUEST_ADDRESS                       = "replace-me"
  KUEST_API_KEY                       = "replace-me"
  KUEST_API_SECRET                    = "replace-me"
  KUEST_PASSPHRASE                    = "replace-me"
  REOWN_APPKIT_PROJECT_ID             = "replace-me"

  # Choose one storage profile:
  # Supabase mode
  SUPABASE_URL                        = "replace-me"
  SUPABASE_SECRET_KEY                 = "replace-me"

  # S3 mode (use this trio when SUPABASE_* is not set)
  # S3_BUCKET                         = "replace-me"
  # S3_ACCESS_KEY_ID                  = "replace-me"
  # S3_SECRET_ACCESS_KEY              = "replace-me"
}
